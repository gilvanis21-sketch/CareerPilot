DATABASE_URL="postgresql://careerpilot:careerpilot_dev@localhost:5433/careerpilot"
# 32 octets en hex (dev uniquement) – chiffrement des secrets (tokens OAuth)
ENCRYPTION_KEY="CHANGE_ME_64_HEX_CHARS"  # openssl rand -hex 32
APP_URL="http://localhost:3112"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
CRON_SECRET=""
ANTHROPIC_WORKSPACE_ID=""   # seulement si la clé n est pas liée à un workspace
TRUST_PROXY=""                    # "1" uniquement derrière un reverse proxy de confiance (lit x-forwarded-for)
ENCRYPTION_KEY_PREVIOUS=""        # ancienne clé, pendant une rotation de ENCRYPTION_KEY
SMTP_HOST=""                      # mails applicatifs (réinitialisation de mot de passe)
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# OAuth2 messagerie (voir docs/oauth-messagerie.md) — redirection : ${APP_URL}/api/oauth/{gmail|outlook}/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Offres réelles d'alternance (La bonne alternance, gratuit) : clé sur https://api.apprentissage.beta.gouv.fr/fr/compte/profil
LBA_API_KEY=""
# "1" = réactive les offres fictives de démonstration (tests, soutenance)
ENABLE_DEMO_OFFERS=""
